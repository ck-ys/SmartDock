# SmartDock 部署环境变量（照 DCS deploy/.env.example 同款）
# 用法：cp .env.example .env，逐项改成自己的值；.env 已 gitignore，绝不提交。

# ── 对外端口 ─────────────────────────────────────────────
# 80 被占用时改这里（如 8088），改完重启 frontend 容器
HTTP_PORT=80

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=smartdock
POSTGRES_USER=postgres
# 生产必须改：openssl rand -base64 24
POSTGRES_PASSWORD=changeit

# ── Redis ───────────────────────────────────────────────
# 生产必须改：openssl rand -base64 24
REDIS_PASSWORD=changeit

# ── MinIO（附件/头像，可选）─────────────────────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ── 字段加密两把钥匙（必填，缺一个后端拒绝启动）────────
# 生成：openssl rand -base64 24（各生成一次，两把必须不同）
# 作用：SMARTDOCK_AI_CONFIG_KEY 解 dcs_ai_config.api_key；
#       SMARTDOCK_MCP_HEADERS_KEY 解 dcs_mcp_server.headers。
# ⚠ 换值后旧密文解不开，需到页面上重填一次 API Key / MCP 令牌。
SMARTDOCK_AI_CONFIG_KEY=
SMARTDOCK_MCP_HEADERS_KEY=
